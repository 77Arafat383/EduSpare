# ---- Database (required) ----
# Supabase Transaction Pooler (port 6543) with pgbouncer=true
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Supabase Session Pooler (port 5432) or direct URL for migrations / prisma db push
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# ---- AI Tutor (add at least ONE key) ----
# The tutor auto-routes each model to its provider and falls back to any other
# configured provider, so a single key of any kind is enough.
# Free options: GROQ_API_KEY (https://console.groq.com) or GEMINI_API_KEY (https://aistudio.google.com)
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# Optional: shown to OpenRouter as the referring app
NEXT_PUBLIC_APP_URL=
