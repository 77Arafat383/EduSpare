# ---- Database (required) ----
DATABASE_URL="postgresql://user:password@localhost:5432/eduspare"

# ---- AI Tutor (add at least ONE key) ----
# The tutor auto-routes each model to its provider and falls back to any other
# configured provider, so a single key of any kind is enough.
# Free options: GROQ_API_KEY (https://console.groq.com) or GEMINI_API_KEY (https://aistudio.google.com)
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# Optional: shown to OpenRouter as the referring app
NEXT_PUBLIC_APP_URL=
